# File: backend/.env.example

# Thay thế bằng Secret Key của bạn từ Google reCAPTCHA
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_goes_here

# Thông tin kết nối Database
DB_HOST=localhost
DB_NAME=JPTechLift
# ...

# Khóa bí mật cho JWT
JWT_SECRET=generate_a_strong_random_secret_key

# Tài khoản admin ban đầu
ADMIN_EMAIL=admin@example.com
# ...